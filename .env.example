# ============================================================
# Algeria Health & Wellness — variables d'environnement
# Copiez ce fichier en `.env.local` et renseignez ce dont vous avez besoin.
# ============================================================

# --- Couche IA -----------------------------------------------------
#
# TOUT EST FACULTATIF. Sans aucune clé, la plateforme fonctionne
# intégralement sur son moteur de règles déterministe : parcours,
# recommandations, estimations et concierge restent opérationnels.
#
# Renseigner une clé active le concierge conversationnel enrichi.
# Les garde-fous médicaux s'appliquent dans les deux cas.

# Clé Anthropic. Le SDK la lit automatiquement depuis cette variable.
# ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé. Par défaut : claude-opus-5
# AI_MODEL=claude-opus-5

# Force le mode moteur de règles même si une clé est présente.
# Utile pour démontrer le comportement hors ligne.
# AI_PROVIDER=off


# --- Base de données (non branchée à ce stade) ---------------------
#
# Le MVP fonctionne sans base : les données de démonstration vivent
# dans /data. Le schéma Prisma est fourni dans /prisma pour la suite.
#
# DATABASE_URL=postgresql://user:password@localhost:5432/algeria_health


# --- Stockage documentaire (non branché à ce stade) ----------------
#
# Le coffre documentaire est actuellement une démonstration côté
# navigateur. Une mise en production impose un stockage chiffré.
#
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
